            attribution="&lt;a href='https://www.openstreetmap.org/copyright' target='_blank'>© les contributeurs d'OpenStreetMap&lt;/a> (ODbL)" />
        <baselayer type="OSM" id="osmfr" thumbgallery="img/basemap/osm.png" label="OpenStreetMap FR" title="OpenStreetMap en français"
